# Beispielhafte Umgebungsvariablen. Kopieren nach .env und ausfuellen.
# Nur Variablen mit dem Praefix EXPO_PUBLIC_ landen im App-Bundle.
# ACHTUNG: EXPO_PUBLIC_-Werte sind im Bundle lesbar - niemals Secrets dort ablegen.

# Kontaktadresse fuer den Knopf "Fehlerbericht an den Entwickler senden" (FR-8.2)
EXPO_PUBLIC_SUPPORT_CONTACT=beispiel@example.com
